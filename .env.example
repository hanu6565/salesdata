# =============================================================================
# (주)올이유 OKPOS 통합 분석 시스템 - 환경 변수 설정 템플릿
# Vercel 프로젝트 설정(Project Settings -> Environment Variables) 또는 .env.local 에 입력
# =============================================================================

# 1. Supabase 데이터베이스 연동 (필수)
# Supabase 대시보드 -> Project Settings -> API 에서 확인 가능
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-server-admin

# 2. POS 가맹점 포털 자동 수집 자격증명 보안 볼트 (선택 / 안전 격리)
# 화면/브라우저 번들에 절대 노출되지 않으며 오직 서버 API에서만 읽음
POS_CRED_STORE_1_ID=forkpan_admin
POS_CRED_STORE_1_PW=your-store-1-secure-pw
POS_CRED_STORE_4_ID=syw_seongseo_admin
POS_CRED_STORE_4_PW=your-store-4-secure-pw
POS_CRED_STORE_5_ID=gmc_jr_admin
POS_CRED_STORE_5_PW=your-store-5-secure-pw
